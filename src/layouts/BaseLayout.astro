---
import '../styles/global.css';
import { getDictionary, getStaticPathsLocales } from '../i18n';
import Navbar from '../components/Navbar.astro';

export async function getStaticPaths() {
    return getStaticPathsLocales();
}

interface Props {
    title?: string;
    lang?: string;
}

const { title = 'Astro', lang = 'en' } = Astro.props;
const dict = getDictionary(Astro.params.lang ?? 'sr');
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <Navbar dict={dict} currentLang={Astro.params.lang} />
        <slot />
    </body>
</html>
