---
import { getDictionary, getStaticPathsLocales } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PageKeys } from '../../types/PageKeys';
import type { Translation } from '../../types/Translation';

export async function getStaticPaths() {
    return getStaticPathsLocales();
}

interface Props {
    pageKey: PageKeys;
}

const { pageKey } = Astro.props;
const dict: Translation = getDictionary(Astro.params.lang ?? 'sr');
const page = dict.pages[pageKey];
---

<BaseLayout title={page?.title ?? 'Untitled'} lang={Astro.params.lang}>
    <main>
        <slot />
    </main>
</BaseLayout>
