---
import { routes } from '../routes/index';
import { getLocaleUrl } from '../i18n';
import type { Translation } from '../types/Translation';

interface Props {
    dict: Translation;
    currentLang: string;
}

const { dict, currentLang } = Astro.props;
const { home, about } = dict.ui.nav;
console.log({ home, about });
---

<nav>
    <a href={getLocaleUrl(currentLang, routes.home)}>
        {home}
    </a>
    <a href={getLocaleUrl(currentLang, routes.about)}>
        {about}
    </a>
    <a href={getLocaleUrl(dict.ui.switchLanguage, Astro.url.pathname)}>
        {dict.ui.switchLabel}
    </a>
</nav>
