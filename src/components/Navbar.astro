---
import { getLocaleUrl } from '../i18n';
import type { SupportedLang } from '../i18n/config';
import { routes } from '../routes/index';
import type { Translation } from '../types/Translation';

interface Props {
    dict: Translation;
    currentLang: SupportedLang;
    currentPath: string;
}

const { dict, currentLang, currentPath } = Astro.props;
const { home, about, rooms, contact } = dict.ui.nav;

const targetLang = currentLang === 'sr' ? 'en' : 'sr';
const switchUrl = getLocaleUrl(targetLang, currentPath);
---

<nav>
    <a href={getLocaleUrl(currentLang, routes.home)}>
        {home}
    </a>
    <a href={getLocaleUrl(currentLang, routes.about)}>
        {about}
    </a>
    <a href={getLocaleUrl(currentLang, routes.rooms)}>
        {rooms}
    </a>
    <a href={getLocaleUrl(currentLang, routes.contact)}>
        {contact}
    </a>
    <a href={switchUrl}>
        {dict.ui.switchLabel}
    </a>
</nav>
