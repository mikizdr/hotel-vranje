---
import type { Translation } from '../../types/Translation';

interface Props {
    dict: Translation;
}

const { dict } = Astro.props;
const {
    contactInfo,
    usefulLinks,
    gallery,
    newsletter,
    newsletterText,
    subscribe,
    emailPlaceholder,
    rights,
} = dict.ui.footer;
const year = new Date().getFullYear();

const socialIcons: Record<string, string> = {
    facebook:
        'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z',
    twitter:
        'M22 5.9c-.7.3-1.5.5-2.3.6.8-.5 1.5-1.3 1.8-2.3-.8.5-1.6.8-2.5 1a4 4 0 0 0-6.8 3.6 11.2 11.2 0 0 1-8.1-4.1 4 4 0 0 0 1.2 5.3c-.6 0-1.2-.2-1.8-.5v.1a4 4 0 0 0 3.2 3.9c-.6.1-1.2.2-1.8.1a4 4 0 0 0 3.7 2.7A8 8 0 0 1 2 18.4a11.3 11.3 0 0 0 6.1 1.8c7.3 0 11.3-6 11.3-11.3v-.5c.8-.6 1.4-1.3 1.9-2.1z',
    linkedin:
        'M6.9 8.4H3.6V20h3.3V8.4zM5.3 3.5A1.9 1.9 0 1 0 5.3 7.3 1.9 1.9 0 0 0 5.3 3.5zM20.4 20h-3.3v-5.9c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V20h-3.3V8.4h3.2v1.6h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5V20z',
    pinterest:
        'M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.7.3-2.6l1.5-6.2s-.4-.8-.4-1.9c0-1.8 1-3.1 2.3-3.1 1.1 0 1.6.8 1.6 1.8 0 1.1-.7 2.7-1 4.2-.3 1.2.6 2.2 1.8 2.2 2.1 0 3.7-2.2 3.7-5.5 0-2.9-2.1-4.9-5-4.9-3.4 0-5.5 2.6-5.5 5.2 0 1 .4 2.1 .9 2.7.1.1.1.2.1.3l-.4 1.5c0 .2-.2.3-.4.2-1.4-.7-2.3-2.7-2.3-4.4 0-3.6 2.6-6.9 7.5-6.9 3.9 0 7 2.8 7 6.6 0 3.9-2.5 7.1-5.9 7.1-1.1 0-2.2-.6-2.6-1.3l-.7 2.7c-.3 1-.9 2.3-1.4 3.1A10 10 0 1 0 12 2z',
};
---

<footer>
    <div class="bg-lightBlack">
        <div
            class="Container grid grid-cols-1 gap-5 pt-14 md:grid-cols-2 lg:grid-cols-10 lg:gap-3 lg:pt-[100px] xl:gap-5 2xl:grid-cols-12 2xl:gap-[30px]"
        >
            <!-- Contact info -->
            <div
                class="bg-[#272727] lg:col-span-3 lg:mt-[-195px] 2xl:col-span-4"
                data-aos="fade-up"
                data-aos-duration="1000"
            >
                <div class="px-10 py-6 md:py-7 lg:px-5 lg:py-[50px] xl:px-8 2xl:px-9">
                    <img src="/images/home-1/logo-1.png" alt="" />
                    <div class="py-8 2xl:py-[50px]">
                        <h1
                            class="font-Garamond before:bg-khaki relative text-lg leading-[38px] font-medium text-white before:absolute before:top-10 before:left-0 before:h-[1px] before:w-7 sm:text-xl md:text-[22px]"
                        >
                            {contactInfo}
                        </h1>
                        <div class="space-y-4 pt-[30px] pb-2 2xl:pb-[30px]">
                            <p
                                class="font-Lora text-lightGray mt-2 flex items-center text-sm leading-[26px] font-normal sm:text-base"
                            >
                                <svg
                                    class="text-khaki mr-3 h-5 w-5 2xl:mr-4"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    ><path
                                        d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
                                    ></path></svg
                                >
                                +980 (1234) 567 220
                            </p>
                            <p
                                class="font-Lora text-lightGray flex items-center text-sm leading-[26px] font-normal sm:text-base"
                            >
                                <svg
                                    class="text-khaki mr-3 h-5 w-5 2xl:mr-4"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    ><path
                                        d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
                                    ></path></svg
                                >
                                example@yahoo.com
                            </p>
                            <p
                                class="font-Lora text-lightGray flex items-center text-sm leading-[26px] font-normal sm:text-base"
                            >
                                <svg
                                    class="text-khaki mr-3 h-5 w-5 flex-shrink-0 2xl:mr-4"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    ><path
                                        d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
                                    ></path></svg
                                >
                                102/B New Elephant Rd <br /> Dhaka - 1212
                            </p>
                        </div>
                    </div>
                    <ul class="flex space-x-3">
                        {
                            Object.entries(socialIcons).map(([name, d]) => (
                                <li class="hover-animBg group border-lightGray/75 hover:border-khaki grid h-[37px] w-[37px] cursor-pointer items-center justify-center rounded-full border transition-all duration-300">
                                    <a href="#" aria-label={name}>
                                        <svg
                                            class="text-lightGray/75 h-4 w-4 group-hover:text-white"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path d={d} />
                                        </svg>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <!-- Useful links -->
            <div
                class="ml-2 overflow-x-hidden pt-0 pb-8 lg:col-span-2 2xl:col-span-2"
                data-aos="fade-up"
                data-aos-duration="1000"
            >
                <h1
                    class="font-Garamond before:bg-khaki relative text-lg leading-[38px] font-medium text-white uppercase before:absolute before:top-10 before:left-0 before:h-[1px] before:w-7 sm:text-xl md:text-[22px]"
                >
                    {usefulLinks}
                </h1>
                <div class="pt-[30px] pb-0 lg:py-[30px]">
                    <ul
                        class="font-Lora text-lightGray list-none space-y-0 text-sm leading-[26px] font-normal hover:list-disc sm:text-base"
                    >
                        <li
                            class="hover:text-khaki leading-[44px] transition-all duration-500 hover:ml-[17px] md:hover:ml-[18px]"
                        >
                            <a href="#">About Hotel</a>
                        </li>
                        <li
                            class="hover:text-khaki leading-[44px] transition-all duration-500 hover:ml-[17px] md:hover:ml-[18px]"
                        >
                            <a href="#">Rooms & Suites</a>
                        </li>
                        <li
                            class="hover:text-khaki leading-[44px] transition-all duration-500 hover:ml-[17px] md:hover:ml-[18px]"
                        >
                            <a href="#">Reservations</a>
                        </li>
                        <li
                            class="hover:text-khaki leading-[44px] transition-all duration-500 hover:ml-[17px] md:hover:ml-[18px]"
                        >
                            <a href="#">News & Blogs</a>
                        </li>
                        <li
                            class="hover:text-khaki leading-[44px] transition-all duration-500 hover:ml-[17px] md:hover:ml-[18px]"
                        >
                            <a href="#">Contact Us</a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Gallery -->
            <div
                class="pt-0 pb-8 lg:col-span-3 2xl:col-span-3"
                data-aos="fade-up"
                data-aos-duration="1000"
            >
                <h1
                    class="font-Garamond before:bg-khaki relative text-lg leading-[38px] font-medium text-white uppercase before:absolute before:top-10 before:left-0 before:h-[1px] before:w-7 sm:text-xl md:text-[22px]"
                >
                    {gallery}
                </h1>
                <div
                    class="mt-[45px] grid w-[250px] grid-cols-3 content-center gap-2 sm:w-[300px] lg:w-full"
                >
                    {
                        [1, 2, 3, 4, 5, 6].map((n) => (
                            <img src={`/images/home-1/gallery-${n}.jpg`} alt="" />
                        ))
                    }
                </div>
            </div>

            <!-- Newsletter -->
            <div
                class="overflow-x-hidden pt-0 pb-8 lg:col-span-2 2xl:col-span-3"
                data-aos="fade-up"
                data-aos-duration="1000"
            >
                <h1
                    class="font-Garamond before:bg-khaki relative text-lg leading-[38px] font-medium text-white uppercase before:absolute before:top-10 before:left-0 before:h-[1px] before:w-7 sm:text-xl md:text-[22px]"
                >
                    {newsletter}
                </h1>
                <div class="space-y-4 py-[30px]">
                    <p
                        class="font-Lora text-lightGray text-sm leading-[26px] font-normal sm:text-base"
                    >
                        {newsletterText}
                    </p>
                    <form class="space-y-4">
                        <input
                            type="email"
                            placeholder={emailPlaceholder}
                            required
                            class="text-gray placeholder:font-Lora placeholder:text-gray focus:border-khaki h-[56px] w-full border-none px-10 text-center text-[15px] outline-none placeholder:text-[15px] placeholder:font-normal focus:ring-0 focus:outline-none"
                        />
                        <button type="submit" class="btn-subscribe">{subscribe}</button>
                    </form>
                </div>
            </div>
        </div>

        <div
            class="font-Lora text-lightGray bg-[#161616] py-5 text-center text-sm font-normal md:text-base 2xl:py-7"
        >
            {`© ${year}, Royella. ${rights}.`}
        </div>
    </div>
</footer>
