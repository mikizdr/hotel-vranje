---
import type { SupportedLang } from '../../i18n/config';
import type { PageContent } from '../../types/Translation';
import BreadCrumb from '../BreadCrumb.astro';

interface Props {
    page: PageContent;
    lang: SupportedLang;
}

const { page, lang } = Astro.props;
---

<section class="">
    <BreadCrumb title="Services" lang={lang} />

    <div class="dark:bg-mediumBlack">
        <section class="Container py-[120px] md:py-0 md:pb-[120px] lg:py-[120px]">
            <div
                class="mb-12 flex flex-col justify-between px-3 sm:px-5 md:flex-row md:items-center"
                data-aos="fade-up"
                data-aos-duration="1000"
            >
                <div class="font-Garamond md:w-[450px]">
                    <h5 class="text-khaki mb-[14px] text-base leading-[26px] font-medium">
                        FACILITIES
                    </h5>
                    <h1
                        class="text-lightBlack text-[22px] leading-[38px] font-semibold sm:text-2xl md:text-3xl lg:leading-[44px] 2xl:text-[38px] dark:text-white"
                    >
                        ENJOY COMPLETE & BEST QUALITY FACILITIES
                    </h1>
                </div>
                <div class="mt-5 md:mt-0">
                    <a href="/contact">
                        <button class="btn-items">view more item</button>
                    </a>
                </div>
            </div>

            <div class="">
                <hr class="my-10 text-[#e8e8e8] dark:text-[#383838]" />
                <div
                    class="grid grid-cols-1 md:grid-cols-2"
                    data-aos="zoom-in-up"
                    data-aos-duration="1000"
                >
                    <div class="relative h-[100%] w-full md:pr-[30px]">
                        <img src="/images/home-1/facilities-1.png" alt="" class="h-full w-full" />
                        <div
                            class="absolute -top-[0px] -right-[7%] hidden md:-right-[12%] md:block"
                        >
                            <h2
                                class="text-khaki text-3xl leading-[38px] md:text-4xl lg:text-[40px]"
                            >
                                01
                            </h2>
                        </div>
                    </div>
                    <div
                        class="font-Garamond relative mt-3 h-full md:mt-0 md:ml-[60px] lg:ml-[107px]"
                    >
                        <h4
                            class="text-khaki mt-2 pb-[6px] text-base leading-[26px] font-semibold uppercase md:mt-0"
                        >
                            Fitness
                        </h4>
                        <h1
                            class="text-lightBlack text-2xl leading-[26px] font-semibold md:text-3xl 2xl:text-[32px] dark:text-white"
                        >
                            <a href="/services">Gym Training Grounds</a>
                        </h1>

                        <p
                            class="font-Lora text-gray dark:text-lightGray relative my-10 text-sm leading-[26px] font-normal before:absolute before:top-[-35px] before:left-0 before:h-[30px] before:w-[1px] before:bg-[#ddd] sm:text-base lg:mt-[46px] lg:mb-[40px]"
                        >
                            Rapidiously myocardinate cross-platform intellectual capital after
                            model. Appropriately create interactive infrastructures after are
                            Holisticly facilitate stand-alone
                        </p>
                        <a href="/services">
                            <svg
                                class="text-gray hover:text-khaki"
                                width="30"
                                height="30"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"><path d="M4 12h16m-6-6 6 6-6 6"></path></svg
                            >
                        </a>
                    </div>
                </div>

                <hr class="mt-10 mb-10 text-[#e8e8e8] dark:text-[#383838]" />
                <div
