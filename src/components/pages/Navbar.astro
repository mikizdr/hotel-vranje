---
import { getLocaleUrl } from '../i18n';
import type { SupportedLang } from '../i18n/config';
import { routes } from '../routes/index';
import type { Translation } from '../types/Translation';

interface Props {
    dict: Translation;
    currentLang: SupportedLang;
    currentPath: string;
}

const { dict, currentLang, currentPath } = Astro.props;
const { home, about, rooms, roomDetails, services, contact, bookingOnline } = dict.ui.nav;

const targetLang = currentLang === 'sr' ? 'en' : 'sr';
const switchUrl = getLocaleUrl(targetLang, currentPath);

const link = (route: string) => getLocaleUrl(currentLang, route);
---

<nav
    id="site-navbar"
    class="font-Lora w-full transition-all duration-300 lg:fixed lg:z-10 lg:bg-transparent lg:px-5 lg:py-2"
>
    <div class="lg:px-10">
        <div class="flex flex-col items-center justify-between lg:flex-row">
            <!-- Logo -->
            <div class="w-48 lg:w-52 lg:p-4">
                <a href={link(routes.home)}>
                    <img
                        src="/images/home-3/logo.png"
                        class="hidden w-full lg:block"
                        alt="website_logo"
                    />
                </a>
            </div>

            <!-- Small screen top bar -->
            <div
                class="bg-khaki text-lightBlack flex h-[70px] w-full items-center justify-between p-3 px-3 lg:hidden lg:text-white dark:text-white"
            >
                <div class="w-28">
                    <a href={link(routes.home)}>
                        <img
                            src="/images/home-1/brand-1.png"
                            class="block lg:hidden"
                            alt="Royella_website_logo"
                        />
                    </a>
                </div>

                <div class="flex items-center">
                    <button
                        id="dark-mode-toggle"
                        class="mr-3 cursor-pointer text-white"
                        aria-label="Toggle theme"
                    >
                        <svg
                            id="icon-moon-sm"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
                                d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36 10.14 10.14 0 1 0 22 14.05a1 1 0 0 0-.36-1.05Z"
                            ></path></svg
                        >
                        <svg
                            id="icon-sun-sm"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="hidden"
                            ><path
                                d="M12 4V2m0 20v-2M4.93 4.93 3.51 3.51m16.98 16.98-1.42-1.42M4 12H2m20 0h-2M4.93 19.07l-1.42 1.42M20.49 3.51l-1.42 1.42M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"
                            ></path></svg
                        >
                    </button>
                    <button
                        id="mobile-menu-toggle"
                        class="block focus:outline-none lg:hidden"
                        aria-label="Toggle menu"
                    >
                        <svg
                            id="icon-bars"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="text-white"><path d="M3 6h18M3 12h18M3 18h18"></path></svg
                        >
                        <svg
                            id="icon-close"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="hidden text-white"><path d="M6 6l12 12M18 6L6 18"></path></svg
                        >
                    </button>
                </div>
            </div>

            <!-- Nav links -->
            <ul
                id="mobile-menu"
                class="text-lightBlack 3xl:space-x-[24px] dark:bg-normalBlack hidden w-full flex-col space-y-2 bg-white py-3 text-left text-sm font-normal uppercase ease-in-out lg:flex lg:w-fit lg:flex-row lg:space-y-0 lg:space-x-3 lg:bg-transparent lg:py-0 lg:text-center lg:text-white xl:space-x-4 2xl:space-x-5 dark:text-white dark:lg:bg-transparent"
            >
                <li class="w-full px-3 py-2 transition-all duration-300">
                    <a href={link(routes.home)} class="block">{home}</a>
                </li>
                <li class="w-full px-3 py-2 transition-all duration-300">
                    <a href={link(routes.about)} class="block">{about}</a>
                </li>
                <li class="group relative w-full px-3 py-2 transition-all duration-300">
                    <span class="flex items-center justify-center">
                        {rooms}
                        <svg
                            class="ml-1 h-3 w-3"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"><path d="M7 10l5 5 5-5z"></path></svg
                        >
                    </span>
                    <div class="z-20 pt-5 lg:absolute lg:pt-8">
                        <ul
                            class="dark:bg-normalBlack hidden w-[200px] rounded-sm bg-white py-4 text-left text-sm text-black shadow-2xl transition-all duration-500 group-hover:block dark:text-white"
                        >
                            <li class="group/item hover:bg-khaki px-5 hover:text-white">
                                <a
                                    href={link(routes.rooms)}
                                    class="block py-2 duration-300 group-hover/item:ml-3">{rooms}</a
                                >
                            </li>
                            <li class="group/item hover:bg-khaki px-5 hover:text-white">
                                <a
                                    href={link(routes.room_details)}
                                    class="block py-2 duration-300 group-hover/item:ml-3"
                                    >{roomDetails}</a
                                >
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="w-full px-3 py-2 transition-all duration-300">
                    <a href={link(routes.services)} class="block">{services}</a>
                </li>
                <li class="w-full px-3 py-2 transition-all duration-300">
                    <a href={link(routes.contact)} class="block">{contact}</a>
                </li>
                <li
                    class="w-full border-t border-white/20 px-3 py-2 transition-all duration-300 lg:hidden"
                >
                    <a href={switchUrl} class="block">{dict.ui.switchLabel}</a>
                </li>
            </ul>

            <!-- Large screen actions -->
            <div class="hidden items-center lg:flex">
                <a href={switchUrl} class="hover:text-khaki mr-4 text-sm text-white uppercase"
                    >{dict.ui.switchLabel}</a
                >
                <button
                    id="dark-mode-toggle-lg"
                    class="group mr-3 cursor-pointer text-white"
                    aria-label="Toggle theme"
                >
                    <svg
                        id="icon-moon-lg"
                        xmlns="http://www.w3.org/2000/svg"
                        width="26"
                        height="26"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="transition-transform duration-300 group-hover:rotate-[360deg]"
                        ><path
                            d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36 10.14 10.14 0 1 0 22 14.05a1 1 0 0 0-.36-1.05Z"
                        ></path></svg
                    >
                    <svg
                        id="icon-sun-lg"
                        xmlns="http://www.w3.org/2000/svg"
                        width="26"
                        height="26"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="rotate hidden transition-transform duration-300"
                        ><path
                            d="M12 4V2m0 20v-2M4.93 4.93 3.51 3.51m16.98 16.98-1.42-1.42M4 12H2m20 0h-2M4.93 19.07l-1.42 1.42M20.49 3.51l-1.42 1.42M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"
                        ></path></svg
                    >
                </button>
                <a href={link(routes.room_details)}>
                    <button class="btn-secondary">{bookingOnline}</button>
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('icon-bars');
    const iconClose = document.getElementById('icon-close');
    menuBtn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconBars?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
    });

    // Dark mode toggle (mirrors original localStorage('darkMode') behavior)
    function setDarkIcons(isDark: boolean) {
        document
            .querySelectorAll('#icon-moon-sm, #icon-moon-lg')
            .forEach((el) => el.classList.toggle('hidden', isDark));
        document
            .querySelectorAll('#icon-sun-sm, #icon-sun-lg')
            .forEach((el) => el.classList.toggle('hidden', !isDark));
    }
    const isDarkNow = document.documentElement.classList.contains('dark');
    setDarkIcons(isDarkNow);

    function toggleDarkMode() {
        const next = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', next);
        localStorage.setItem('darkMode', String(next));
        setDarkIcons(next);
    }
    document.getElementById('dark-mode-toggle')?.addEventListener('click', toggleDarkMode);
    document.getElementById('dark-mode-toggle-lg')?.addEventListener('click', toggleDarkMode);

    // Background color on scroll (matches original useScrollPosition threshold of 100px)
    const navbar = document.getElementById('site-navbar');
    function onScroll() {
        if (window.scrollY > 100) {
            navbar?.classList.add('lg:bg-lightBlack');
            navbar?.classList.remove('lg:bg-transparent');
        } else {
            navbar?.classList.add('lg:bg-transparent');
            navbar?.classList.remove('lg:bg-lightBlack');
        }
    }
    window.addEventListener('scroll', onScroll);
    onScroll();
</script>
